pipeline {
    agent {
        label 'jenkins-agent'
    }

    parameters {
        string(name: 'TargetBranch', description: 'Target branch to merge into')
    }

    environment {
        CREDENTIALS = credentials('jira-jenkins-bot')
        AWS_REGION = 'us-east-1'
    }

    triggers {
        // Trigger automatically on commits to develop branch
        pollSCM('H/5 * * * *') // Poll SCM every 5 minutes
    }

    stages {
        stage('Get Selected Branches') {
            steps {
                script {
                    SOURCE_BRANCH = "develop"
                    TARGET_BRANCH = params.TargetBranch
                    echo "Source branch: ${SOURCE_BRANCH}"
                    echo "Target branch: ${TARGET_BRANCH}"
                }
            }
        }

        stage('Setup Variables') {
            steps {
                script {
                    echo "QA Build - Merging ${SOURCE_BRANCH} into ${TARGET_BRANCH}"

                    // Sanitize branch name for Docker tags (replace / with -)
                    env.DOCKER_BRANCH = TARGET_BRANCH.replace('/', '-')
                    echo "Docker branch tag: ${env.DOCKER_BRANCH}"

                    // Resolve the ECR registry from the agent's own AWS identity so no
                    // account id is hardcoded here. env.* set in this stage reaches every
                    // later stage, including the ones that run on other agents.
                    env.AWS_ACCOUNT_ID = sh(
                        script: "aws sts get-caller-identity --query Account --output text",
                        returnStdout: true
                    ).trim()
                    env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                    echo "ECR registry: ${env.ECR_REGISTRY}"

                    ecrLogin();
                    mergeChanges();

                    dir('sequentum-mcp') {
                        def versionFile = "version_state_qa.json"

                        echo "=== QA Version Management ==="
                        echo "Version file: ${versionFile}"

                        // Extract release number from branch name (e.g., "release/1.1" -> "1.1")
                        def releaseNumber = TARGET_BRANCH.replaceAll(/^release\//, '')
                        echo "Release number: ${releaseNumber}"

                        // Load existing version state or create default
                        def versionState = [:]
                        def fileFound = fileExists(versionFile)
                        echo "Version file exists: ${fileFound}"

                        if (fileFound) {
                            def stateJson = readFile(versionFile)
                            echo "Raw JSON content: ${stateJson}"
                            // Parse JSON manually in a CPS-compliant way
                            versionState = parseVersionState(stateJson)
                            echo "Loaded existing version state: ${versionState}"
                        } else {
                            echo "Version file not found, initializing with beta 0"
                            versionState = [
                                release: releaseNumber,
                                beta_count: 0,
                                last_version: "${releaseNumber}.0-beta.0"
                            ]
                            echo "Created new version state with beta count: 0"
                        }

                        // Check if release branch changed - reset beta counter
                        if (versionState.release != releaseNumber) {
                            echo "Release changed from ${versionState.release} to ${releaseNumber} - resetting beta counter"
                            versionState.release = releaseNumber
                            versionState.beta_count = 1
                        } else {
                            versionState.beta_count += 1
                        }

                        // Generate new beta version (e.g., 1.1.0-beta.1)
                        def newVersion = "${releaseNumber}.0-beta.${versionState.beta_count}"
                        versionState.last_version = newVersion
                        env.VERSION = newVersion

                        echo "=== QA Version Set ==="
                        echo "New version: ${newVersion}"
                        echo "Beta count for release ${releaseNumber}: ${versionState.beta_count}"

                        // Store version state in environment variables for later use
                        env.VERSION_RELEASE = versionState.release as String
                        env.VERSION_BUILD = versionState.beta_count as String

                        echo "Version ${newVersion} prepared - will be committed after successful build"
                    }
                }
            }
        }

        stage('Parallel Builds') {
            parallel {
                stage('Build x64') {
                    agent {
                        label 'jenkins-agent'
                    }
                    steps {
                        script {
                            def startTime = new Date()
                            echo "x64 Build starting at: ${startTime.format('yyyy-MM-dd HH:mm:ss')}"
                            echo "Using version: ${env.VERSION}"
                            ecrLogin();
                            mergeChanges();
                        }
                        dir('sequentum-mcp') {
                            sh '''
                                # Install coreutils if missing (fixes nohup issue)
                                if ! command -v nohup >/dev/null 2>&1; then
                                    echo "Installing coreutils for nohup"
                                    apt-get update && apt-get install -y coreutils || apk add --no-cache coreutils || yum install -y coreutils || true
                                fi

                                # Create buildx builder for native x64 builds
                                if ! docker buildx ls | grep -q "native-x64"; then
                                    docker buildx create --use --name native-x64 --driver docker-container --bootstrap
                                else
                                    docker buildx use native-x64
                                fi
                            '''
                            sh """
                                # Build x64 architecture image natively and push to ECR
                                docker buildx build \\
                                    --platform linux/amd64 \\
                                    --build-arg VERSION=${VERSION} \\
                                    -t ${ECR_REGISTRY}/sequentum-mcp:${DOCKER_BRANCH}-amd64 \\
                                    -t ${ECR_REGISTRY}/sequentum-mcp:qa-amd64 \\
                                    -t ${ECR_REGISTRY}/sequentum-mcp:${VERSION}-amd64 \\
                                    -t ${ECR_REGISTRY}/sequentum-mcp:latest-qa-amd64 \\
                                    -f Dockerfile \\
                                    --provenance=false \\
                                    --output type=image,push=true \\
                                    ./
                            """
                        }
                    }
                }
                stage('Build ARM64') {
                    agent {
                        label 'jenkins-agent-arm64'
                    }
                    steps {
                        script {
                            def startTime = new Date()
                            echo "ARM64 Build starting at: ${startTime.format('yyyy-MM-dd HH:mm:ss')}"
                            echo "Using version: ${env.VERSION}"
                            ecrLogin();
                            mergeChanges();
                        }
                        dir('sequentum-mcp') {
                            sh '''
                                # Install coreutils if missing (fixes nohup issue)
                                if ! command -v nohup >/dev/null 2>&1; then
                                    echo "Installing coreutils for nohup"
                                    apt-get update && apt-get install -y coreutils || apk add --no-cache coreutils || yum install -y coreutils || true
                                fi

                                # Create buildx builder for native ARM64 builds
                                if ! docker buildx ls | grep -q "native-arm64"; then
                                    docker buildx create --use --name native-arm64 --driver docker-container --bootstrap
                                else
                                    docker buildx use native-arm64
                                fi
                            '''
                            sh """
                                # Build ARM64 architecture image natively and push to ECR
                                docker buildx build \\
                                    --platform linux/arm64 \\
                                    --build-arg VERSION=${VERSION} \\
                                    -t ${ECR_REGISTRY}/sequentum-mcp:${DOCKER_BRANCH}-arm64 \\
                                    -t ${ECR_REGISTRY}/sequentum-mcp:qa-arm64 \\
                                    -t ${ECR_REGISTRY}/sequentum-mcp:${VERSION}-arm64 \\
                                    -t ${ECR_REGISTRY}/sequentum-mcp:latest-qa-arm64 \\
                                    -f Dockerfile \\
                                    --provenance=false \\
                                    --output type=image,push=true \\
                                    ./
                            """
                        }
                    }
                }
            }
        }



        stage('Create Multi-Arch Manifest') {
            agent {
                label 'jenkins-agent'
            }
            steps {
                script {
                    ecrLogin();
                }
                sh """
                    # Remove any existing manifests to avoid conflicts
                    docker manifest rm ${ECR_REGISTRY}/sequentum-mcp:${DOCKER_BRANCH} || true
                    docker manifest rm ${ECR_REGISTRY}/sequentum-mcp:qa || true
                    docker manifest rm ${ECR_REGISTRY}/sequentum-mcp:${VERSION} || true
                    docker manifest rm ${ECR_REGISTRY}/sequentum-mcp:latest-qa || true

                    # Create and push multi-architecture manifests
                    docker manifest create \\
                        ${ECR_REGISTRY}/sequentum-mcp:${DOCKER_BRANCH} \\
                        ${ECR_REGISTRY}/sequentum-mcp:${DOCKER_BRANCH}-amd64 \\
                        ${ECR_REGISTRY}/sequentum-mcp:${DOCKER_BRANCH}-arm64

                    docker manifest create \\
                        ${ECR_REGISTRY}/sequentum-mcp:qa \\
                        ${ECR_REGISTRY}/sequentum-mcp:qa-amd64 \\
                        ${ECR_REGISTRY}/sequentum-mcp:qa-arm64

                    docker manifest create \\
                        ${ECR_REGISTRY}/sequentum-mcp:${VERSION} \\
                        ${ECR_REGISTRY}/sequentum-mcp:${VERSION}-amd64 \\
                        ${ECR_REGISTRY}/sequentum-mcp:${VERSION}-arm64

                    docker manifest create \\
                        ${ECR_REGISTRY}/sequentum-mcp:latest-qa \\
                        ${ECR_REGISTRY}/sequentum-mcp:latest-qa-amd64 \\
                        ${ECR_REGISTRY}/sequentum-mcp:latest-qa-arm64

                    # Push manifests to create universal ImageIndex
                    docker manifest push ${ECR_REGISTRY}/sequentum-mcp:${DOCKER_BRANCH}
                    docker manifest push ${ECR_REGISTRY}/sequentum-mcp:qa
                    docker manifest push ${ECR_REGISTRY}/sequentum-mcp:${VERSION}
                    docker manifest push ${ECR_REGISTRY}/sequentum-mcp:latest-qa
                """
            }
        }

        stage('Commit Version') {
            agent {
                label 'jenkins-agent'
            }
            steps {
                script {
                    echo "Build successful - committing version changes (no git tags for QA)"

                    // Merge changes and prepare repository
                    mergeChanges()

                    dir('sequentum-mcp') {
                        // Write the updated version state file
                        sh """
                            echo "=== Writing QA Version State File ==="
                            echo "Release: ${env.VERSION_RELEASE}, Beta: ${env.VERSION_BUILD}, Version: ${env.VERSION}"

                            cat > version_state_qa.json << 'JSONEOF'
{
  "release": "${env.VERSION_RELEASE}",
  "beta_count": ${env.VERSION_BUILD},
  "last_version": "${env.VERSION}"
}
JSONEOF

                            echo "QA Version state file written"
                            echo "Verifying file contents:"
                            cat version_state_qa.json
                        """

                        // Commit the version state file
                        sh """
                            echo "=== Committing QA Version Changes ==="
                            git config user.email "jenkins@sequentum.com"
                            git config user.name "jenkins"

                            echo "Adding version_state_qa.json to git..."
                            git add version_state_qa.json

                            echo "Checking for changes to commit..."
                            if git diff --cached --quiet; then
                                echo "No changes to commit"
                            else
                                echo "Committing version increment..."
                                git commit -m "Increment QA version to ${VERSION} - Generated by Jenkins build automation"
                                echo "Committed version increment: ${VERSION}"
                            fi

                            echo "Pushing commits to remote..."
                            git push
                            echo "Pushed commits successfully"

                            echo "QA version management completed (no git tags created for QA builds)"
                        """
                    }
                }
            }
        }

        stage('Deploy to QA') {
            agent {
                label 'jenkins-agent'
            }
            steps {
                sh """
                    echo 'Deploying to QA ECS'
                    aws ecs update-service --cluster sequentum-mcp-qa-cluster --service sequentum-mcp-qa-ecs-service --force-new-deployment --region us-east-1
                    # wait 2 minutes for deployment
                    sleep 120
                """
            }
        }
    }

    post {
        success {
            echo "QA Build completed successfully - ${SOURCE_BRANCH} merged into ${TARGET_BRANCH}"
        }
        failure {
            echo "QA Build failed"
        }
    }
}

// Parse version state JSON in a CPS-compliant way
@NonCPS
def parseVersionState(String jsonText) {
    def slurper = new groovy.json.JsonSlurper()
    def lazyMap = slurper.parseText(jsonText)
    // Convert LazyMap to a regular HashMap to avoid serialization issues
    return [
        release: lazyMap.release as String,
        beta_count: lazyMap.beta_count as Integer,
        last_version: lazyMap.last_version as String
    ]
}

// Download the native docker container to the executor
def ecrLogin() {
    sh '''
        # Log into AWS
        aws ecr get-login-password --region "${AWS_REGION}" \
            | docker login --username AWS --password-stdin "${ECR_REGISTRY}"
    '''
}

// merge the latest code from sequentum-mcp
def mergeChanges() {
    sh "rm -rf sequentum-mcp"
    sh "git clone git@github.com-sequentum-mcp:Sequentum/sequentum-mcp.git && cd sequentum-mcp && git checkout ${SOURCE_BRANCH} && git pull"
    sh """
        cd sequentum-mcp
        git config user.email "jenkins@sequentum.com"
        git config user.name "jenkins"

        # merge release branch
        git checkout ${TARGET_BRANCH}
        git pull
        git merge -Xtheirs ${SOURCE_BRANCH}

        # Push merged changes
        git push
    """
}
